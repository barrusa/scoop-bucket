{
    "version": "8.2.6.0",
    "description": "Your wonderful to-do & task list to make all things done and get life well organized.",
    "homepage": "https://ticktick.com/home",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.ticktick.app/download/win64/tick_win_setup_release_x64_8260.exe",
            "hash": "147be7b553e78a99379932e601f0499ddb452b3607dcf2ee31108e0cb58d8a18"
        },
        "32bit": {
            "url": "https://download.ticktick.app/download/win/tick_win_setup_release_x86_8260.exe",
            "hash": "217acfcdef303438066b6774190108bd86ed792e9b8494dc0356a9cf45c6247c"
        }
    },
    "shortcuts": [
        [
            "TickTick.exe",
            "TickTick"
        ]
    ],
    "persist": "TickTick.exe.config",
    "checkver": {
        "script": [
            "$req = [System.Net.HttpWebRequest]::Create('https://ticktick.com/static/getApp/download?type=win64')",
            "$req.AllowAutoRedirect = $false",
            "$res = $req.GetResponse()",
            "$loc = $res.Headers['Location']",
            "$res.Close()",
            "$loc"
        ],
        "regex": "tick_win_setup_release_x64_(\\d)(\\d)(\\d)(\\d)\\.exe",
        "replace": "${1}.${2}.${3}.${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.ticktick.app/download/win64/tick_win_setup_release_x64_$cleanVersion.exe"
            },
            "32bit": {
                "url": "https://download.ticktick.app/download/win/tick_win_setup_release_x86_$cleanVersion.exe"
            }
        }
    },
    "innosetup": true
}
